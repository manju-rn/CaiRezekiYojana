# Copy to .env for local development. Never commit the real one.

# Supabase Postgres - see deploy/01-secrets.yaml for where to find it.
# Use the "Session pooler" or "Direct connection" string. The "Transaction
# pooler" (port 6543) also works if you add ?statement-cache-capacity=0.
#   CAIREZEKI_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Or, for a quick local run with no Supabase at all, SQLite:
CAIREZEKI_DATABASE_URL=sqlite://./data/cairezeki.db?mode=rwc

CAIREZEKI_BIND=0.0.0.0:8080

# Where the built React app lives. In development, run Vite separately and
# leave this pointing at a directory that does not exist yet.
CAIREZEKI_STATIC_DIR=./static

# Apply pending migrations at startup.
CAIREZEKI_AUTO_MIGRATE=true

# Only needed when the UI is served from a different origin than the API.
# CAIREZEKI_CORS_ORIGINS=http://localhost:5173

CAIREZEKI_LOG=cairezeki=debug,tower_http=warn,info
